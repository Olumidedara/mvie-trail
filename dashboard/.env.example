# GitHub repo that hosts the pipeline + releases. Public reads, no token needed.
NEXT_PUBLIC_GITHUB_OWNER=your-github-username
NEXT_PUBLIC_GITHUB_REPO=movie-storybot

# Fine-grained PAT with "Actions" read/write + "Contents" read/write on the repo.
# Only needed on the Vercel server (never expose in NEXT_PUBLIC_).
GH_PAT=

# Optional: protect /api/cron. If set, Vercel sends it automatically as a Bearer header.
CRON_SECRET=

# Schedule store: @vercel/kv reads exactly these two names.
# Create a free Redis at upstash.com (or Vercel Redis) and paste its REST URL/token here.
# The provider doesn't matter — only these variable names do.
KV_REST_API_URL=
KV_REST_API_TOKEN=